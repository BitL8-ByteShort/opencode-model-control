            "orchestrator": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "code-worker": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "vision-worker": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "reviewer": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          }
        },
        "api": {
          "type": "object",
          "properties": {
            "id": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-z0-9@~][a-z0-9._:+/@~-]*$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "npm": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[@a-z0-9][@a-z0-9/._-]*$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "url": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uri"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "id",
            "npm",
            "url"
          ],
          "additionalProperties": false
        },
        "pricing": {
          "type": "object",
          "properties": {
            "class": {
              "type": "string",
              "enum": [
                "free",
                "paid",
                "unknown"
