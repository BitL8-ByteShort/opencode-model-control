            "rates": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^(?:(?:context:\\d+|context_over_200k|mode:[a-z0-9_-]{1,80})\\.)?(?:input|output|reasoning|cache_read|cache_write|input_audio|output_audio)$"
